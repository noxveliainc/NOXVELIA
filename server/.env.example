NODE_ENV=production
PORT=4000
CLIENT_URL=https://www.noxvelia.com
FRONTEND_URL=https://www.noxvelia.com
MONGODB_URI=mongodb+srv://UTILIZADOR:PASSWORD@CLUSTER/noxvelia
JWT_SECRET=GERAR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=12h
GOOGLE_CLIENT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
RESEND_API_KEY=
RESEND_TRANSACTIONAL_FROM='"NOXVELIA" <suporte@noxvelia.com>'
RESEND_PARTNERSHIPS_FROM='"Noxvelia Parcerias" <geral@noxvelia.com>'
RESEND_REPLY_TO=geral@noxvelia.com
RESEND_WEBHOOK_SECRET=
APP_URL=https://www.noxvelia.com
PUBLIC_API_URL=https://www.noxvelia.com/api
EMAIL_LOGO_URL=https://www.noxvelia.com/logo-noxvelia.png
PARTNERSHIP_UNSUBSCRIBE_SECRET=GERAR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
PARTNERSHIP_DAILY_LIMIT=40
PARTNERSHIP_BATCH_SIZE=5
PARTNERSHIP_BATCH_INTERVAL_SECONDS=60

# Imagens processadas no backend
IMAGE_STORAGE_DRIVER=s3
IMAGE_STORAGE_PATH=storage/images
IMAGE_PUBLIC_BASE_URL=https://noxvelia.onrender.com/api/media
IMAGE_MAX_UPLOAD_BYTES=12582912
IMAGE_MAX_PIXEL_COUNT=24000000
IMAGE_MAX_IMAGES_PER_LISTING=10
IMAGE_MAX_FILES_PER_REQUEST=10
IMAGE_WEBP_QUALITY=82
IMAGE_THUMBNAIL_QUALITY=74
IMAGE_PROCESSING_CONCURRENCY=2

# Storage compativel com S3/R2/B2/MinIO (necessario em producao no Render sem Persistent Disk)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Opcional. Consultar docs/SPONSORS.md.
SPONSOR_CAMPAIGNS_JSON=[]

# Segurança opcional Cloudflare Turnstile. Mantém desligado até configurares as chaves.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Monitorização interna do frontend. Ativa por defeito; mete false para desligar.
CLIENT_ISSUES_ENABLED=true
CLIENT_ISSUE_SALT=
